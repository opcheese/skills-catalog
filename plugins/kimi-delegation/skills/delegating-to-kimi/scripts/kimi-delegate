#!/usr/bin/env bash
# Run one delegated task on Kimi and stream the result back.
#
#   kimi-delegate --via kimi|claude [--agent NAME] [--cwd DIR]
#                 [--output text|stream-json] [--final-only]
#                 -- <prompt>
#
# Exit codes: the child's own, except 75 when a Kimi quota or rate limit
# stopped the run and 65 when Kimi rejected the request itself.
#
# --via kimi    Kimi's own agent system. Defaults to the read-only `explore`
#               agent, because an unqualified `kimi -p` edits the working
#               tree with no approval gate.
# --via claude  Claude Code itself, running on Kimi's Anthropic-compatible
#               endpoint, keeping its own tools and permission system.

set -uo pipefail

MIN_KIMI_VERSION="0.38.0"
KIMI_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
# k3.1-pro, not k3: on the Kimi Code plan quota is metered per model, and `k3`
# is the 1M-context variant at about twice the quota. `k3` is also offered by
# both the managed provider and an imported office key on a typical machine,
# where an unqualified default is refused as ambiguous.
DEFAULT_MODEL="k3.1-pro"
MODEL="${KIMI_DELEGATE_MODEL:-$DEFAULT_MODEL}"
# Overridable, because a key issued somewhere other than the coding plan is
# answered somewhere other than the coding plan -- api.moonshot.ai/anthropic,
# or a regional host. The subscription route has no such freedom: its token is
# minted for this endpoint and is worthless anywhere else.
BASE_URL="${KIMI_DELEGATE_BASE_URL:-https://api.kimi.com/coding}"

# An API key is a complete credential on its own: no `kimi login`, no CLI, no
# refresh. So in key mode the preflight checks that exist to protect those two
# are not merely unnecessary -- they would refuse a machine that is perfectly
# able to run the task. Non-empty, not merely set: `KIMI_API_KEY=` is what a
# sourced .env leaves behind for a key you do not have.
API_KEY_PRESENT=0
if [ -n "${KIMI_API_KEY:-}" ] || [ -n "${MOONSHOT_API_KEY:-}" ]; then
  API_KEY_PRESENT=1
fi

# Filled in below, once we know which credential this run will actually spend.
AUTH="subscription-token"
MODEL_NOTE=""

# Where this skill is installed. Resolved next to the script itself, which is
# true under every harness -- Claude Code, Codex, a bare clone. The env vars
# only override that: KIMI_DELEGATION_ROOT is the harness-neutral name, and
# CLAUDE_PLUGIN_ROOT is accepted as an alias. Claude Code does not export it to
# the Bash tool; it only fills in ${CLAUDE_PLUGIN_ROOT} in a skill's text.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CRED_HELPER="$SCRIPT_DIR/kimi-credential"
AGENT_FILE="$SCRIPT_DIR/../agents/delegate-readonly.md"

SKILL_ROOT="${KIMI_DELEGATION_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}"
if [ -n "$SKILL_ROOT" ]; then
  if [ -x "$SKILL_ROOT/skills/delegating-to-kimi/scripts/kimi-credential" ]; then
    CRED_HELPER="$SKILL_ROOT/skills/delegating-to-kimi/scripts/kimi-credential"
  fi
  if [ -f "$SKILL_ROOT/skills/delegating-to-kimi/agents/delegate-readonly.md" ]; then
    AGENT_FILE="$SKILL_ROOT/skills/delegating-to-kimi/agents/delegate-readonly.md"
  fi
fi

die() { printf 'kimi-delegate: %s\n' "$1" >&2; exit 1; }

# Say what this ran on. Without it a delegated answer carries no record of the
# model or the endpoint that produced it, and two runs cannot be compared.
# stderr, so it never contaminates the answer on stdout.
# `auth` belongs here for the same reason the model does: a run on a personal
# API key and a run on a subscription token are two different accounts, two
# different bills, and potentially two different model pools. An answer that
# does not say which one produced it cannot be compared with the next.
# `served=unconfirmed` because nothing here can see which model answered: Kimi
# answers HTTP 200 for any name, falls back silently on a mistyped one, and
# neither its output nor its log names the model that replied.
provenance() {
  printf 'kimi-delegate: via=%s model=%s%s served=unconfirmed endpoint=%s agent=%s auth=%s thinking=%s\n' \
    "$1" "$MODEL" "$MODEL_NOTE" "$3" "$2" "$AUTH" "$4" >&2
}

# A delegated run must not change the machine under its peers or hang on a
# spent quota. The CLI's update preflight can install a new version in the
# background, for every session at once (0.38.0 -> 2.5.1 mid-run, 2026-11-05);
# infinite retry turns a quota failure into a run that never ends.
export KIMI_CODE_NO_AUTO_UPDATE=1 KIMI_DISABLE_TELEMETRY=1
unset KIMI_CODE_INFINITE_RETRY

# Run the delegate, passing its output through live, then classify a failure.
# Not `exec`: once the child has exited, only this script is left to read why.
# Quota and rejected-request errors come back as exit 1 with an empty stdout,
# so a wrapper that reads stdout for a verdict sees "no verdict" and nothing
# else. FIFOs rather than process substitution, so bash 3.2 runs it too.
run_child() {
  local tmp rc po pe child
  tmp="$(mktemp -d)" || die "cannot create a temporary directory"
  mkfifo "$tmp/o" "$tmp/e" || die "cannot create FIFOs in $tmp"
  if [ "$FINAL_ONLY" -eq 1 ]; then
    cat < "$tmp/o" > "$tmp/out" & po=$!
  else
    tee "$tmp/out" < "$tmp/o" & po=$!
  fi
  tee "$tmp/err" < "$tmp/e" >&2 & pe=$!
  # A background job's stdin defaults to /dev/null; give it ours explicitly.
  "$@" <&0 > "$tmp/o" 2> "$tmp/e" & child=$!
  trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
  wait "$child"; rc=$?
  # A trapped signal interrupts wait; wait again for the child's real status.
  if kill -0 "$child" 2>/dev/null; then wait "$child"; rc=$?; fi
  trap - TERM INT HUP
  wait "$po" "$pe" 2>/dev/null

  if [ "$rc" -ne 0 ]; then
    classify_failure "$tmp/out" "$tmp/err" "$rc"; rc=$?
  elif [ "$FINAL_ONLY" -eq 1 ]; then
    final_answer "$tmp/out"; rc=$?
  fi
  rm -rf "$tmp"
  exit "$rc"
}

classify_failure() {
  local all window reason
  all="$(cat "$1" "$2" 2>/dev/null)"
  if printf '%s' "$all" | grep -qiE 'usage limit|\(429\)|rate limit|too many requests'; then
    window=unknown
    if printf '%s' "$all" | grep -qiE '5-hour'; then window=5-hour; fi
    if printf '%s' "$all" | grep -qiE 'weekly|7-day'; then window=weekly; fi
    printf 'kimi-delegate: quota-exhausted window=%s reset=window-end\n' "$window" >&2
    return 75
  fi
  reason="$(printf '%s\n' "$all" | grep -oiE '(invalid request|tokenization failed|context (length|window)|request too large)[^.]*' | head -1)"
  if [ -n "$reason" ]; then
    printf 'kimi-delegate: request-rejected reason=%s\n' "$reason" >&2
    printf 'kimi-delegate: Kimi refused the request itself. Try a smaller input: one bundle of the diff and the touched functions instead of whole files, or split the task. Any partial reasoning is in the stderr above.\n' >&2
    return 65
  fi
  return "$3"
}

# stream-json carries every assistant message in order; the last non-empty one
# is the answer, and everything before it is progress chatter.
final_answer() {
  python3 - "$1" <<'FINALPY'
import json, sys
last = None
for line in open(sys.argv[1], errors="replace"):
    try:
        obj = json.loads(line)
    except ValueError:
        continue
    if not isinstance(obj, dict) or obj.get("role") != "assistant":
        continue
    content = obj.get("content")
    if isinstance(content, list):
        content = "".join(p.get("text", "") for p in content
                          if isinstance(p, dict) and p.get("type") == "text")
    if isinstance(content, str) and content.strip():
        last = content
if last is None:
    sys.stderr.write("kimi-delegate: --final-only found no final answer in the output\n")
    sys.exit(1)
print(last)
FINALPY
}

if [ "${KIMI_DELEGATE_DEPTH:-0}" -ge 1 ]; then
  die "delegation is already in progress (depth ${KIMI_DELEGATE_DEPTH}); refusing to nest"
fi
export KIMI_DELEGATE_DEPTH=$(( ${KIMI_DELEGATE_DEPTH:-0} + 1 ))

VIA=""
AGENT=""
CWD=""
OUTPUT="text"
OUTPUT_SET=0
FINAL_ONLY=0
PROMPT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --final-only) FINAL_ONLY=1; shift ;;
    --via|--agent|--cwd|--output)
      # `shift 2` on a lone flag fails and leaves $@ unchanged, which spins
      # this loop forever. Require the value before consuming anything.
      [ $# -ge 2 ] || die "missing value for $1"
      case "$1" in
        --via)    VIA="$2" ;;
        --agent)  AGENT="$2" ;;
        --cwd)    CWD="$2" ;;
        --output) OUTPUT="$2"; OUTPUT_SET=1 ;;
      esac
      shift 2 ;;
    --dangerously-skip-permissions|--allow-dangerously-skip-permissions)
      die "refusing --dangerously-skip-permissions; delegation never bypasses permission checks" ;;
    --) shift; PROMPT="$*"; break ;;
    *)  die "unknown argument: $1" ;;
  esac
done

[ -n "$VIA" ] || die "--via kimi|claude is required"
[ -n "$PROMPT" ] || die "a prompt is required after --"
if [ "$FINAL_ONLY" -eq 1 ] && [ "$OUTPUT_SET" -eq 1 ]; then
  die "--final-only reads stream-json itself and prints the answer as text; drop --output"
fi

KIMI_BIN="${KIMI_BIN:-$(command -v kimi 2>/dev/null || printf '%s' "$KIMI_HOME/bin/kimi")}"

# Only --via kimi always needs the CLI. --via claude needs it solely to obtain
# and refresh a subscription token, which an API key makes moot.
KEY_HINT=""
if [ "$API_KEY_PRESENT" -eq 1 ]; then
  KEY_HINT="
Your API key does not help here: --via kimi runs Kimi's own agent system, which
authenticates through its own OAuth provider. Spend the key with --via claude."
fi
older_than() {
  # Not `sort -V`: that is GNU-only, and BSD sort would fall back to lexical
  # order, where 0.9.0 reads as newer than 0.38.0 and an old CLI walks through
  # the gate. python3 is already required elsewhere in this script.
  python3 - "$1" "$2" <<'PY'
import sys
def parts(v):
    return [int(x) for x in v.split(".")]
sys.exit(0 if parts(sys.argv[1]) < parts(sys.argv[2]) else 1)
PY
}

require_kimi_cli() {
  [ -x "$KIMI_BIN" ] || die "Kimi CLI not found. Install: curl -fsSL https://code.kimi.com/kimi-code/install.sh | bash$KEY_HINT"

  # Take the first dotted triple and nothing else. `tr -d '[:space:]'` would
  # glue an update banner onto the number, and the result sorts after every
  # real version -- letting a too-old CLI through the gate meant to stop it.
  KIMI_VERSION="$("$KIMI_BIN" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
  if [ -z "$KIMI_VERSION" ] || older_than "$KIMI_VERSION" "$MIN_KIMI_VERSION"; then
    die "Kimi CLI is ${KIMI_VERSION:-unknown}; $MIN_KIMI_VERSION or newer is required for --agent.
Note that \`kimi upgrade\` misdetects native Linux installs. Upgrade with:
  curl -fsSL https://code.kimi.com/kimi-code/install.sh | bash"
  fi

  [ -f "$KIMI_HOME/credentials/kimi-code.json" ] || die "no Kimi credentials. Run: kimi login$KEY_HINT"
}

if [ "$VIA" = "kimi" ] || [ "$API_KEY_PRESENT" -eq 0 ]; then
  require_kimi_cli
else
  AUTH="api-key"
fi

# Kimi answers HTTP 200 for a model it has never heard of -- a mistyped model
# is served by something else entirely, with no error and nothing in the
# transcript naming what replied. Measured 2026-08-24: `model:
# "totally-not-a-model"` returned 200 and a normal answer. So check the name
# here, against the models this install actually declares.
# Resolve the model against the providers this install actually declares, and
# read the endpoint and the credential kind off the provider that backs it.
#
# A model alias is `provider/model`. Before 1.2.0 this script stripped the
# `kimi-code/` prefix, validated the bare name, and then never passed `-m` to
# the CLI at all on Path A -- so every `--via kimi` run silently took
# `default_model`, whatever the caller asked for. A key-bearing provider was
# therefore unreachable from Path A, which is why this skill used to say an
# API key had no way in. It does: an imported provider carries its own key.
RESOLVED="$(python3 - "$KIMI_HOME/config.toml" "$MODEL" <<'PYRESOLVE'
import re, sys

path, want = sys.argv[1], sys.argv[2]
try:
    text = open(path).read()
except OSError:
    sys.exit(0)

providers, models, section = {}, [], None
for line in text.splitlines():
    header = re.match(r'\s*\[([^\]]+)\]', line)
    if header:
        section = header.group(1)
        m = re.match(r'models\."([^"]+)"$', section)
        if m:
            models.append(m.group(1))
        m = re.match(r'providers\."?([^".]+)"?(\.oauth)?$', section)
        if m:
            # `[providers."managed:kimi-code"]` backs models aliased
            # `kimi-code/...`. Keying on the raw section name leaves the
            # managed provider unfindable, and an unfindable provider reads
            # as "no oauth" -- reporting a subscription run as a key run.
            prov = providers.setdefault(m.group(1).split(":", 1)[-1],
                                        {"oauth": False, "base_url": ""})
            if m.group(2):
                prov["oauth"] = True
        continue
    if section and section.startswith("providers.") and line.strip().startswith("base_url"):
        m = re.match(r'providers\."?([^".]+)"?$', section)
        if m:
            providers[m.group(1).split(":", 1)[-1]]["base_url"] = line.split("=", 1)[1].strip().strip('"')

if not models:
    sys.exit(0)

# An unqualified name matches on the model half, and only if exactly one
# provider offers it. Two providers offering `k3` is the whole point of this
# change, and picking one of them for the caller is how the wrong account gets
# billed in silence.
if "/" in want:
    matches = [m for m in models if m == want]
else:
    matches = [m for m in models if m.split("/", 1)[-1] == want]

print("MODELS=" + " ".join(sorted(models)))
if len(matches) == 1:
    qualified = matches[0]
    prov = providers.get(qualified.split("/", 1)[0])
    print("QUALIFIED=" + qualified)
    print("ENDPOINT=" + ((prov or {}).get("base_url") or ""))
    # A provider the file does not declare tells us nothing about its
    # credential. Reporting it as a key would be a guess, and the --via claude
    # guard below refuses on exactly that word.
    if prov is not None:
        print("AUTHKIND=" + ("subscription-token" if prov.get("oauth") else "provider-api-key"))
elif len(matches) > 1:
    print("AMBIGUOUS=" + " ".join(sorted(matches)))
PYRESOLVE
)"

KNOWN_MODELS="$(printf '%s\n' "$RESOLVED" | sed -n 's/^MODELS=//p' | tr ' ' '\n')"
QUALIFIED="$(printf '%s\n' "$RESOLVED" | sed -n 's/^QUALIFIED=//p')"
AMBIGUOUS="$(printf '%s\n' "$RESOLVED" | sed -n 's/^AMBIGUOUS=//p')"
RESOLVED_ENDPOINT="$(printf '%s\n' "$RESOLVED" | sed -n 's/^ENDPOINT=//p')"
RESOLVED_AUTH="$(printf '%s\n' "$RESOLVED" | sed -n 's/^AUTHKIND=//p')"

if [ -n "$AMBIGUOUS" ]; then
  die "'$MODEL' is offered by more than one provider, and those are different
accounts with different bills. Name the provider:
$(printf '%s\n' $AMBIGUOUS | sed 's/^/  /')"
fi

if [ -z "$KNOWN_MODELS" ]; then
  # Unverifiable is not the same as valid. Refuse a model the caller chose on
  # purpose; let the built-in default through, since blocking it would break
  # every delegation over a config we merely failed to parse.
  if [ "${KIMI_DELEGATE_SKIP_MODEL_CHECK:-}" != "1" ] && [ "$MODEL" != "$DEFAULT_MODEL" ]; then
    die "cannot verify the model '$MODEL': there is no model list to check it against.
A key issued outside the coding plan has no local config.toml, so this is
expected there. Kimi answers HTTP 200 for a model it has never heard of, which
is why an unverifiable name is refused rather than sent. To take that risk on
purpose: KIMI_DELEGATE_SKIP_MODEL_CHECK=1"
  fi
  # Everything that survives this branch was let through, not checked -- the
  # default included. `k3` is a coding-plan name, and a key issued off that
  # plan is answered HTTP 200 by some other model and billed for it. Marking
  # only the deliberate opt-out would leave the silent case, which is the one
  # nobody is watching for, as the one that looks verified.
  MODEL_NOTE=" (unverified)"
elif [ -z "$QUALIFIED" ]; then
  die "'$MODEL' is not a model this Kimi install offers. Available:
$(printf '%s\n' "$KNOWN_MODELS" | sed 's/^/  /')
This list is read from $KIMI_HOME/config.toml and may be stale. The plan's
models are cached at \`kimi login\`: run it again to refresh them. An imported
provider's list is hand-written there; add the model under that provider."
fi

# Path B authenticates with the subscription token or KIMI_API_KEY, never with
# a provider's own key from config.toml. A model resolved to a key-bearing
# provider would otherwise run on the subscription, whatever its name says:
# three passes burned a weekly window that way (2026-10-29).
if [ "$VIA" = "claude" ] && [ "$RESOLVED_AUTH" = "provider-api-key" ]; then
  KEY_PROVIDER="${QUALIFIED%%/*}"
  if [ "$API_KEY_PRESENT" -eq 0 ]; then
    die "--via claude cannot spend the key of provider '$KEY_PROVIDER': it authenticates
with the subscription token or KIMI_API_KEY only, so this run would bill the
subscription. Use --via kimi, which spends that provider's key, or export
the key as KIMI_API_KEY."
  fi
  printf "kimi-delegate: warning: '%s' belongs to provider '%s', but --via claude spends KIMI_API_KEY, not that provider's configured key\n" "$QUALIFIED" "$KEY_PROVIDER" >&2
fi

# Path A and Path B want different halves of the same name, and conflating them
# is what the tests below caught. Path A selects a *provider's* model, so it
# needs `provider/model`. Path B hands the name to Claude Code as
# `ANTHROPIC_MODEL` on a base URL that already fixes the provider, so it needs
# the bare name -- and its credential comes from `kimi-credential`, not from
# the provider config, so the resolved credential kind must not touch it.
PATHA_MODEL="${QUALIFIED:-$MODEL}"
MODEL="${MODEL#*/}"

# The endpoint of the provider that backs the chosen model -- not the first
# base_url in the file. With two providers configured, reporting the first one
# is a wrong answer dressed as provenance, and provenance is the only place a
# reader can see which account a run spent.
KIMI_CLI_ENDPOINT="${RESOLVED_ENDPOINT:-unknown, set by Kimi provider config}"


[ -n "$CWD" ] && { cd "$CWD" || die "no such directory: $CWD"; }

case "$VIA" in
  kimi)
    MODEL="$PATHA_MODEL"
    [ -n "$RESOLVED_AUTH" ] && AUTH="$RESOLVED_AUTH"
    # Kimi documents KIMI_MODEL_THINKING_EFFORT as a per-run override, for
    # `type = "kimi"` providers only. It is not a flag here: on an
    # anthropic-type provider it does nothing, and no run has yet shown it
    # changing anything on the wire. If the caller set it, say so.
    THINKING="on (effort from config.toml)"
    if [ -n "${KIMI_MODEL_THINKING_EFFORT:-}" ]; then
      THINKING="on (KIMI_MODEL_THINKING_EFFORT=$KIMI_MODEL_THINKING_EFFORT, kimi-type providers only)"
    fi
    [ "$FINAL_ONLY" -eq 1 ] && OUTPUT="stream-json"
    if [ -n "$AGENT" ]; then
      # An explicitly named agent is the caller's choice, and is resolved by
      # Kimi's normal discovery order -- which a repo-local definition can win.
      provenance "kimi" "$AGENT (caller's choice, resolved by Kimi)" "$KIMI_CLI_ENDPOINT" "$THINKING"
      run_child "$KIMI_BIN" -p "$PROMPT" -m "$MODEL" --agent "$AGENT" --output-format "$OUTPUT"
    fi
    # The default is pinned to the definition shipped beside this script.
    # A bare `--agent explore` would be resolved project-first, so any repo
    # could override the read-only built-in and take back write access.
    [ -f "$AGENT_FILE" ] || die "the read-only agent definition is missing: $AGENT_FILE"
    provenance "kimi" "delegate-readonly (pinned file)" "$KIMI_CLI_ENDPOINT" "$THINKING"
    run_child "$KIMI_BIN" -p "$PROMPT" -m "$MODEL" --agent-file "$AGENT_FILE" --output-format "$OUTPUT"
    ;;
  claude)
    command -v claude >/dev/null 2>&1 || die "the claude CLI is not on PATH"
    [ -x "$CRED_HELPER" ] || die "kimi-credential is missing or not executable: $CRED_HELPER"
    SETTINGS="$(python3 - "$CRED_HELPER" "$MODEL" "$BASE_URL" <<'PY'
import json, sys
helper, model, base_url = sys.argv[1], sys.argv[2], sys.argv[3]
print(json.dumps({
    "env": {
        "ANTHROPIC_BASE_URL": base_url,
        "ANTHROPIC_MODEL": model,
        # An inherited key would outrank apiKeyHelper and would then be sent
        # to api.kimi.com. Blank both so the helper is the only credential.
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_AUTH_TOKEN": "",
    },
    "apiKeyHelper": helper,
}, indent=None, separators=(", ", ": ")))
PY
)"
    # Without this, a failed python3 leaves SETTINGS empty and the "delegated"
    # task quietly runs on the caller's own Anthropic account.
    [ -n "$SETTINGS" ] || die "could not build the settings for the delegated session"
    # claude -p refuses stream-json without --verbose and exits before any work.
    OUTPUT_FLAGS=(--output-format "$OUTPUT")
    [ "$OUTPUT" = "stream-json" ] && OUTPUT_FLAGS+=(--verbose)
    if [ -n "$AGENT" ]; then
      provenance "claude" "$AGENT" "$BASE_URL" "on (no dial exists)"
      FINAL_ONLY=0  # claude -p text output is already the final answer only
      run_child claude -p "$PROMPT" --settings "$SETTINGS" --agent "$AGENT" "${OUTPUT_FLAGS[@]}"
    fi
    provenance "claude" "default" "$BASE_URL" "on (no dial exists)"
    FINAL_ONLY=0  # claude -p text output is already the final answer only
    run_child claude -p "$PROMPT" --settings "$SETTINGS" "${OUTPUT_FLAGS[@]}"
    ;;
  *) die "--via must be kimi or claude, got: $VIA" ;;
esac
